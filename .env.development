# Entorno DESARROLLO - se usa automaticamente con npm run dev
VITE_NODE_ENV=development
VITE_APP_NAME=Neps Prode Dashboard

# API Configuracion - DESARROLLO LOCAL
VITE_API_BASE_URL=https://localhost:7163/api
VITE_API_TIMEOUT=15000

# Autenticacion
VITE_JWT_SECRET_KEY=
VITE_TOKEN_EXPIRE_DAYS=7

# Otros
VITE_ENABLE_DEBUG=true
VITE_LOG_LEVEL=info