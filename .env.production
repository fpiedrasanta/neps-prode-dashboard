# Entorno PRODUCCION - se usa automaticamente con npm run build
VITE_NODE_ENV=production
VITE_APP_NAME=Neps Prode Dashboard

# API Configuracion - PRODUCCION
VITE_API_BASE_URL=https://prode-api.neps.com.ar/api
VITE_API_TIMEOUT=15000

# Autenticacion
VITE_JWT_SECRET_KEY=
VITE_TOKEN_EXPIRE_DAYS=7

# Otros
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=error